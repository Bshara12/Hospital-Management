<odoo>

  <!-- List View -->
  <record id="view_hospital_medical_supply_list" model="ir.ui.view">
    <field name="name">hospital.medical.supply.list</field>
    <field name="model">hospital.medical.supply</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="supply_type" />
        <field name="quantity" />
        <field name="unit" />
        <field name="appointment_id" />
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_hospital_medical_supply_form" model="ir.ui.view">
    <field name="name">hospital.medical.supply.form</field>
    <field name="model">hospital.medical.supply</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="supply_type" />
              <field name="quantity" />
              <field name="unit" />
            </group>

            <group>
              <field name="appointment_id" />
            </group>
          </group>

          <notebook>
            <page string="Notes">
              <field name="notes" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_hospital_medical_supply" model="ir.actions.act_window">
    <field name="name">Medical Supplies</field>
    <field name="res_model">hospital.medical.supply</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menu -->
  <menuitem id="hospital_medical_supply_menu"
    name="Medical Supplies"
    parent="hospital_management_root_menu"
    action="action_hospital_medical_supply"
    sequence="40" />

</odoo>