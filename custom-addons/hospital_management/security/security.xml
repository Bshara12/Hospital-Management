<odoo>

  <!-- Group 1: System Administrator -->
  <record id="group_hospital_system_admin" model="res.groups">
    <field name="name">Hospital / System Administrator</field>
    <field name="implied_ids" eval="[
      (4, ref('base.group_system')),
      (4, ref('hr.group_hr_manager')),
      (4, ref('stock.group_stock_manager')),
      (4, ref('purchase.group_purchase_manager')),
      (4, ref('account.group_account_manager')),
      (4, ref('project.group_project_manager'))
    ]" />
  </record>


  <!-- Project task assignees: Doctor / Receptionist (read assigned tasks only) -->
  <record id="group_hospital_project_assignee" model="res.groups">
    <field name="name">Hospital / Project Task Assignee</field>
    <field name="comment">Can view only project tasks assigned to the user.</field>
  </record>


  <!-- Group 2: Medical Operations Manager -->
  <record id="group_hospital_ops_manager" model="res.groups">
    <field name="name">Hospital / Medical Operations Manager</field>
    <field name="implied_ids" eval="[
      (4, ref('base.group_user')),
      (4, ref('hr.group_hr_user')),
      (4, ref('stock.group_stock_user')),
      (4, ref('project.group_project_manager'))
    ]" />
  </record>


  <!-- Group 3: Doctor / Clinician -->
  <record id="group_hospital_doctor" model="res.groups">
    <field name="name">Hospital / Doctor</field>
    <field name="implied_ids" eval="[
      (4, ref('base.group_user')),
      (4, ref('hr.group_hr_user')),
      (4, ref('stock.group_stock_user')),
      (4, ref('hospital_management.group_hospital_project_assignee'))
    ]" />
  </record>


  <!-- Group 4: Receptionist / Dispatcher -->
  <record id="group_hospital_receptionist" model="res.groups">
    <field name="name">Hospital / Receptionist</field>
    <field name="implied_ids" eval="[
      (4, ref('base.group_user')),
      (4, ref('hr.group_hr_user')),
      (4, ref('account.group_account_invoice')),
      (4, ref('hospital_management.group_hospital_project_assignee'))
    ]" />
  </record>


  <!-- Group 5: Medical Inventory Officer -->
  <record id="group_hospital_inventory_officer" model="res.groups">
    <field name="name">Hospital / Medical Inventory Officer</field>
    <field name="implied_ids" eval="[
      (4, ref('base.group_user')),
      (4, ref('stock.group_stock_manager')),
      (4, ref('purchase.group_purchase_user'))
    ]" />
  </record>


  <!-- Group 6: Procurement Manager -->
  <record id="group_hospital_procurement" model="res.groups">
    <field name="name">Hospital / Procurement Manager</field>
    <field name="implied_ids" eval="[
      (4, ref('base.group_user')),
      (4, ref('hr.group_hr_user')),
      (4, ref('stock.group_stock_user')),
      (4, ref('purchase.group_purchase_manager'))
    ]" />
  </record>


  <!-- Group 7: Maintenance Technician -->
  <record id="group_hospital_maintenance" model="res.groups">
  <field name="name">Hospital / Maintenance Technician</field>
  <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]" />
</record>


  <!-- Group 8: Accountant -->
  <record id="group_hospital_accountant" model="res.groups">
    <field name="name">Hospital / Accountant</field>
    <field name="implied_ids" eval="[
      (4, ref('base.group_user')),
      (4, ref('hr.group_hr_user')),
      (4, ref('purchase.group_purchase_user')),
      (4, ref('account.group_account_invoice'))
    ]" />
  </record>
  
  <menuitem id="maintenance.menu_maintenance_title" 
          name="Maintenance" 
          groups="hospital_management.group_hospital_maintenance,hospital_management.group_hospital_system_admin,hospital_management.group_hospital_ops_manager"/>

  <menuitem id="stock.menu_stock_root" 
          name="Inventory" 
          groups="hospital_management.group_hospital_inventory_officer,hospital_management.group_hospital_system_admin"/>

          
</odoo>